CATALOG:

curl "http://localhost:8484/catalog"
# Expected 8

curl "http://localhost:8484/catalog?category=CLOTHING"
# Expected: PROD001 (10.99), PROD004 (15.00), PROD007 (18.20)

curl "http://localhost:8484/catalog?category=SHOES"
# Expected: PROD002 (12.49), PROD006 (5.50)

curl "http://localhost:8484/catalog?category=ACCESSORIES"
# Expected: PROD003 (8.75), PROD005 (22.99), PROD008 (9.99)

curl "http://localhost:8484/catalog?price_less_than=10.00"
# Expected: PROD006 (5.50), PROD003 (8.75), PROD008 (9.99)

curl "http://localhost:8484/catalog?price_less_than=15.00"
# Expected: PROD001 (10.99), PROD002 (12.49), PROD006 (5.50), PROD003 (8.75), PROD008 (9.99)

curl "http://localhost:8484/catalog?price_less_than=20.00"
# Expected: All except PROD005 (22.99)

curl "http://localhost:8484/catalog?category=CLOTHING&price_less_than=15.00"
# Expected: PROD001 (10.99)

curl "http://localhost:8484/catalog?category=SHOES&price_less_than=10.00"
# Expected: PROD006 (5.50)

curl "http://localhost:8484/catalog?category=ACCESSORIES&price_less_than=20.00"
# Expected: PROD003 (8.75), PROD008 (9.99)

curl "http://localhost:8484/catalog?category=CLOTHING&price_less_than=5.00"
# Expected: Empty array, total: 0

curl "http://localhost:8484/catalog?limit=3&offset=0"
# Expected: 3 products, total: 8

curl "http://localhost:8484/catalog?limit=3&offset=3"
# Expected: 3 products, total: 8

curl "http://localhost:8484/catalog?category=CLOTHING&limit=2&offset=0"
# Expected: 2 products, total: 3

curl "http://localhost:8484/catalog?category=CLOTHING&limit=2&offset=2"
# Expected: 1 product, total: 3

curl "http://localhost:8484/catalog?offset=20"
# Expected: Empty array, total: 8

curl "http://localhost:8484/catalog?category=ELECTRONICS"
# Expected: Empty array, total: 0

curl "http://localhost:8484/catalog?price_less_than=abc"
# Expected: All products (filter ignored)